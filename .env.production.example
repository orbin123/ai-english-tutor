# =============================================================================
# LingosAI — PRODUCTION env template
# =============================================================================
# Copy to your server's .env and fill in every angle-bracket placeholder.
# NOTE: the host bootstrap rejects the file if ANY line - comments included -
# still contains an angle-bracket placeholder, so do not reintroduce one in a
# comment. The backend also enforces
# a fail-fast guard (app/core/config.py::_guard_production): with
# ENVIRONMENT=production it REFUSES TO BOOT if any of these are unsafe —
#   DEBUG, SQL_ECHO, DEV_OTP_BYPASS must be false
#   OTP_HASHING_SECRET must be set (no jwt_secret fallback in prod)
#   AUTH_COOKIE_SECURE must be true
#   CORS_ORIGINS must contain only explicit public HTTPS origins
#   DB_POOL_SIZE + DB_MAX_OVERFLOW must not exceed 5
#   Azure PostgreSQL must use Entra managed identity without a password
#   Azure private/internal containers must remain private
#   memory rate limiting requires exactly one worker
# So a forgotten override surfaces at startup, not as a silent security hole.
# =============================================================================

# ========================================
# Application
# ========================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info
# Never echo SQL in prod — it floods logs and can leak schema/PII.
SQL_ECHO=false
# Replace with the separately approved Vercel/custom frontend origin(s). The
# reserved example.com value is intentionally not a production hostname.
CORS_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com

# ========================================
# Database (PostgreSQL) — Entra-only Azure Flexible Server
# ========================================
# The VM identity is mapped to the exact PostgreSQL role vm-lingosai-prod.
# Keep the URL passwordless: SQLAlchemy injects a fresh Entra token before each
# new DBAPI connection. sslmode=require is mandatory and the sole query option.
DATABASE_AUTH_MODE=azure-managed-identity
DATABASE_URL=postgresql://vm-lingosai-prod@<server>.postgres.database.azure.com:5432/lingosai?sslmode=require
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10

# ========================================
# Process topology and AI rate-limit storage
# ========================================
# Azure zero-cost production runs one application worker and deliberately uses
# process-local buckets; Redis is not required. For an approved multi-worker or
# frozen AWS recovery deployment, select "redis" and set REDIS_URL instead.
WEB_CONCURRENCY=1
AI_RATE_LIMIT_BACKEND=memory
REDIS_URL=

# ========================================
# Authentication
# ========================================
# Generate: openssl rand -hex 32
JWT_SECRET=<long-random-string>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh-cookie sessions. MUST be secure behind https. Frontend + backend must
# share a registrable domain (app.example.com / api.example.com) — SameSite=Lax.
ACCESS_TOKEN_TTL_MINUTES=20
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_REMEMBER_DAYS=90
AUTH_COOKIE_SECURE=true

# ========================================
# Email delivery + OTP verification
# ========================================
# Azure production uses the separately capped external provider.
EMAIL_PROVIDER=resend
# Only needed if EMAIL_PROVIDER=resend.
RESEND_API_KEY=<resend-api-key>
# Docker's --env-file path does not require shell quoting; keep display-name
# quotes out of the literal value passed to Resend.
EMAIL_FROM=LingosAI <noreply@lingosai.com>
CONTACT_RECIPIENT_EMAIL=support@lingosai.com
# REQUIRED in prod — distinct from JWT_SECRET. Generate: openssl rand -hex 32
OTP_HASHING_SECRET=<distinct-long-random-string>
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5
# MUST be false — true would let anyone verify any account with "123456".
DEV_OTP_BYPASS=false

# ========================================
# Razorpay (Test Mode)
# ========================================
# Production currently runs Razorpay in TEST mode: test keys cost nothing and
# still exercise the whole order -> checkout -> webhook path, so signup with a
# paid plan works end to end without moving real money. Swap the rzp_test_ key
# for the live one, and re-point the webhook, only when going commercially live.
# The webhook secret is the value set when creating the webhook (Settings ->
# Webhooks) subscribed to payment.captured, payment.failed and order.paid, with
# the URL https://api.lingosai.com/api/payments/webhook.
RAZORPAY_KEY_ID=<rzp_test_...>
RAZORPAY_KEY_SECRET=<razorpay-test-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>

# ========================================
# Google OAuth
# ========================================
GOOGLE_CLIENT_ID=<client-id>
GOOGLE_CLIENT_SECRET=<client-secret>
GOOGLE_REDIRECT_URI=https://api.example.com/auth/google/callback

# ========================================
# Sentry
# ========================================
# Deliberately empty: error reporting to Sentry is off in this deployment.
# Set the DSN to turn it back on; the sample rate below is then honoured.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ========================================
# Rate limiting (AI endpoints)
# ========================================
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_PER_MINUTE=30
AI_RATE_LIMIT_TRANSCRIBE_PER_MINUTE=20
# Process-local: zero-cost production must keep WEB_CONCURRENCY=1.
AI_MAX_CONCURRENT_JOBS=3
MAX_AUDIO_UPLOAD_BYTES=5242880
MAX_AUDIO_DURATION_SECONDS=45
WS_MESSAGE_RATE_PER_MINUTE=20
WS_A2Z_STREAMS_PER_MINUTE=10

# ========================================
# Zero-cost quotas, feature switches, and retention
# ========================================
# Persistent counters fail closed before provider calls, so each quota below is
# a real monthly ceiling rather than an estimate.
QUOTA_COUNTERS_ENABLED=true
QUOTA_DAILY_COMPLETED_LESSONS=50
QUOTA_MONTHLY_BLOB_WRITES=8000
QUOTA_MONTHLY_SPEECH_MINUTES=240
QUOTA_MONTHLY_TTS_CHARS=400000
QUOTA_MONTHLY_LLM_TOKENS=5000000
# Image generation is ON, so this is a finite cap instead of a kill switch.
# COST: gpt-image-2 bills the OPENAI_API_KEY account per image (roughly $0.04
# at medium quality) - that is the API wallet, NOT a ChatGPT subscription. This
# counter is the only real guard, so keep it finite.
QUOTA_MONTHLY_IMAGE_GENS=300
ENABLE_IMAGE_GENERATION=true
# Deepgram powers the A2Z game's live speech stream. Free-tier credit covers
# this deployment's volume.
ENABLE_DEEPGRAM=true
# The mentor note ("Coach's Note") needs BOTH switches below plus a reachable
# Pinecone index. Enabling only one produces a degraded note, so they move
# together. The index must already exist at dimension 1024 / metric cosine or
# every upsert fails silently - see the Pinecone section.
ENABLE_RAG_FEEDBACK=true
ENABLE_MENTOR_SAMPLING=true
LEARNER_RECORDING_RETENTION_DAYS=7
TTS_CACHE_RETENTION_DAYS=30

# ========================================
# AI Services
# ========================================
OPENAI_API_KEY=<openai-key>
# Pinned explicitly so a code-default change cannot silently alter production
# cost or latency. The interactive agents (teacher, evaluator, feedback) run on
# the fast non-reasoning default; task generation and the quality judge have
# their own clients.
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_REASONING_EFFORT=medium
OPENAI_TASKGEN_MODEL=gpt-4o-mini
OPENAI_TASKGEN_REASONING_EFFORT=high
AI_EVAL_JUDGE_MODEL=gpt-4.1
AI_EVAL_JUDGE_REASONING_EFFORT=high
# DATA RESIDENCY: when true, learner session content/goals/responses are sent to
# api.smith.langchain.com. This is a deliberate, documented decision for this
# deployment - tracing is the only view into why a tutoring turn went wrong, and
# the LangSmith free tier covers the volume. It is a privacy tradeoff, not a
# cost one. (See audit A5.) Set false to stop sending learner content off-box.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=<langsmith-key>
LANGCHAIN_PROJECT=ai-english-coach
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ========================================
# Blob storage (generated media)
# ========================================
# Azure uses managed identity through DefaultAzureCredential; never put account
# keys or SAS tokens here. Replace only the account-name placeholders after the
# two approved storage accounts exist. Public/private/internal names must be
# distinct. Only the public container permits direct anonymous blob reads;
# "container" access is rejected because it would expose object listing.
STORAGE_BACKEND=azure
AZURE_BLOB_PUBLIC_ACCOUNT_URL=https://<public-storage-account>.blob.core.windows.net
AZURE_BLOB_PRIVATE_ACCOUNT_URL=https://<private-storage-account>.blob.core.windows.net
AZURE_BLOB_PUBLIC_CONTAINER=public-media
AZURE_BLOB_PRIVATE_CONTAINER=learner-media
AZURE_BLOB_INTERNAL_CONTAINER=internal-media
AZURE_BLOB_PUBLIC_CONTAINER_ACCESS=blob
AZURE_BLOB_PRIVATE_CONTAINER_ACCESS=private
AZURE_BLOB_INTERNAL_CONTAINER_ACCESS=private

# ========================================
# Text-to-Speech (OpenAI)
# ========================================
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
TTS_CACHE_DIR=app/ai/tts/_cache
TTS_PUBLIC_URL_PREFIX=/audio

# ========================================
# Speech-to-Text (OpenAI + Deepgram)
# ========================================
OPENAI_STT_MODEL=whisper-1
STT_CACHE_DIR=app/ai/stt/_cache
# Required now that ENABLE_DEEPGRAM=true. console.deepgram.com -> API Keys.
DEEPGRAM_API_KEY=<deepgram-key>

# ========================================
# Pronunciation Scoring (Azure Speech)
# ========================================
AZURE_SPEECH_KEY=<azure-speech-key>
AZURE_SPEECH_REGION=<approved-speech-region>
PRONUNCIATION_CACHE_DIR=app/ai/pronunciation/_cache

# ========================================
# Image Generation (OpenAI)
# ========================================
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_OUTPUT_FORMAT=png
IMAGEGEN_CACHE_DIR=app/ai/imagegen/_cache
IMAGEGEN_PUBLIC_URL_PREFIX=/images

# ========================================
# Vector DB (Pinecone) — create the index manually first (dimension 1024, cosine)
# ========================================
PINECONE_API_KEY=<pinecone-key>
PINECONE_INDEX_NAME=lingosai-responses
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_FEEDBACK_NAMESPACE=feedback_memory

# ========================================
# RAG / Embeddings
# ========================================
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024
RAG_RECURRENCE_MIN_COUNT=2
RAG_PER_ACTIVITY_FEEDBACK=false
OPENAI_EMBEDDING_TIMEOUT_S=30
PINECONE_OPERATION_TIMEOUT_S=30
RAG_MENTOR_NOTE_TIMEOUT_S=8
RAG_PER_ACTIVITY_TIMEOUT_S=5
